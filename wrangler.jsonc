{
  // NGS — Cloudflare Pages + D1 binding for the tamper-resistant leaderboard.
  // The `database_id` is filled in by `scripts/server-init.sh` after
  // `wrangler d1 create ngs-leaderboard` returns the UUID. Until that runs,
  // the binding is a placeholder and the leaderboard endpoints will 500.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "pages_build_output_dir": ".",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ngs-leaderboard",
      "database_id": "09690148-0d9a-4030-8efd-9b3a15cfdb8e"
    }
  ]
}
